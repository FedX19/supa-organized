# SupaOrganized's Supabase (for the app itself)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Encryption key for customer credentials (min 32 characters)
ENCRYPTION_KEY=your-32-character-minimum-encryption-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Revenue ──────────────────────────────────────────────────────────────
# UniteHQ bills TWO different ways and both keys are needed for a complete
# revenue picture. Either can be omitted; the corresponding panel then reports
# "not configured" rather than silently showing $0.
#
# MDC Individual is billed DIRECTLY on this account (no Connect, no app fee):
STRIPE_SECRET_KEY=sk_live_or_test_key_for_mdc_direct_billing
# The coach marketplace runs on Stripe CONNECT — each coach has their own
# account and the platform takes 8%. Reading those requires the platform key:
STRIPE_PLATFORM_SECRET_KEY=sk_live_or_test_platform_key_for_connect

# ── Daily digest ─────────────────────────────────────────────────────────
# Where the digest is sent, and the shared secret the Vercel cron uses to call
# it. Without CRON_SECRET the digest route refuses to run (it never defaults
# open, because it reads production data with a service-role key).
RESEND_API_KEY=re_your_resend_key
FOUNDER_EMAIL=you@example.com
CRON_SECRET=a-long-random-string
